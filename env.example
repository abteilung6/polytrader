# Required: Wallet private key (export from your wallet)
# API credentials are automatically derived from the private key
PRIVATE_KEY=your_private_key_here
FUNDER=your_magic_wallet_address_here
SIGNATURE_TYPE=1

# Required: PostgreSQL Database Configuration
# PostgreSQL is mandatory for event persistence
DB_HOST=localhost
DB_PORT=5432
DB_DATABASE=polytrader
DB_USER=polytrader
DB_PASSWORD=change_me

# Optional: Metrics Backend Configuration
# Default: prometheus (for Grafana dashboards)
# Set to 'memory' if you need in-memory metrics (mainly for testing)
METRICS_BACKEND=prometheus
